MONGODB_URI=mongodb://localhost:27017/scriptorium
MAILGUN_API_KEY=your-key-here
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Scriptorium
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Header holding the real client IP for the sign-up/recovery throttles. Behind
# Cloudflare set cf-connecting-ip (safe only while no container publishes a port;
# see docs/deployment.md → Client IP). Unset: the socket address is used.
# CLIENT_IP_HEADER=cf-connecting-ip
# Local dev only: docker-compose.yml defaults this to true, logging every request in
# as dev@localhost. Set false to use the real login flow. Ignored when NODE_ENV=production.
# DEV_AUTH_BYPASS=false
