# Nightly scriptorium backup: the dump, its off-box copy to DO Spaces (only if
# the dump succeeded) and a Healthchecks.io ping, all run by
# scriptorium-backup-run (see docs/deployment.md → Data).
# Install as /etc/cron.d/scriptorium-backup (no dot in the name, or cron
# skips it). The droplet runs on UTC: 18:00 UTC is 02:00 in Kuala Lumpur
# (UTC+8, no daylight saving). Debian/Ubuntu cron ignores CRON_TZ.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 18 * * * root /usr/local/sbin/scriptorium-backup-run >> /var/log/scriptorium-backup.log 2>&1
